{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "functions"
    },
    {
      "source": "backend",
      "codebase": "backend",
      "ignore": [
        "node_modules",
        "test",
        ".gitignore"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/connect",
        "function": {
          "functionId": "connect",
          "region": "us-central1"
        }
      },
      {
        "source": "/callback",
        "function": {
          "functionId": "callback",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "/cr/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
